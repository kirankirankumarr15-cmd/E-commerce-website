NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key      # server only, never expose to the browser

APP_URL=http://localhost:3000   # used in message links
CRON_SECRET=your_long_random_cron_secret                      # Bearer token for cron worker
RESEND_API_KEY=your_resend_api_key                            # email provider (e.g. re_...)
MAIL_FROM="Nova Mart <orders@your-domain.com>"

# Optional SMS / WhatsApp Notifications (falls back to console in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
